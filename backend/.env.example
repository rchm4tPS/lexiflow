# Backend Environment Variables Template
# Copy this to .env (not committed to git)

PORT=3000
NODE_ENV=development

# JWT Security
JWT_SECRET=your_super_secret_jwt_key_here

# Database Configuration
# Local file: the value MUST start with `file:`. Anything else is treated as a
# remote (Turso) URL and the auth token below is attached to it.
DATABASE_URL=file:sqlite.db
# Only used for a remote database. Leave empty for local SQLite.
DATABASE_AUTH_TOKEN=

# Optional: LingQ API token for server-side dictionary hints (/vocab/hints) and import fallbacks
# LINGQ_TOKEN=

# Cloudinary — for user image and audio uploads (required in production)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Login throttling (all optional; defaults shown) ---
# Failed logins allowed per (email, ip) before the account locks.
MAX_LOGIN_ATTEMPTS=5
# How long the lockout lasts once the threshold is reached.
LOGIN_LOCKOUT_MINUTES=15
# Failed logins allowed per IP across any address. Stops address-rotation.
# Defaults to MAX_LOGIN_ATTEMPTS * 4 (minimum 20).
MAX_LOGIN_ATTEMPTS_PER_IP=20

# --- Registration availability lookup (anonymous, per IP) ---
# That endpoint reveals whether a username/email is registered, so it is limited.
AVAILABILITY_RATE_LIMIT=30
AVAILABILITY_RATE_WINDOW_SECONDS=60

# Set by the host to enable the keep-alive self-ping (e.g. Render). No-op otherwise.
# RENDER_EXTERNAL_URL=
