# API Base URL (Default for local docker dev)
VITE_API_URL=http://localhost:3000/api/v1

# --- Backend Secrets ---
DATABASE_URL=libsql://your-db.turso.io
DATABASE_AUTH_TOKEN=your-token
JWT_SECRET=change_me

# --- Login throttling ---
# Failed logins allowed per (email, ip) before the account locks.
MAX_LOGIN_ATTEMPTS=5
# How long the lockout lasts once the threshold is reached.
LOGIN_LOCKOUT_MINUTES=15
# Failed logins allowed per IP alone, across any address. Stops an attacker
# sidestepping the per-account limit by rotating emails. Kept deliberately high
# so one person mistyping on a shared connection is never locked out.
# Defaults to MAX_LOGIN_ATTEMPTS * 4 (minimum 20).
MAX_LOGIN_ATTEMPTS_PER_IP=20

# --- Registration availability lookup ---
# Requests per IP per window against /auth/check-availability. That endpoint is
# anonymous and reports whether a username or email is registered, so it is also
# a way to enumerate accounts. Generous enough for the sign-up form, which
# debounces to one call per field.
AVAILABILITY_RATE_LIMIT=30
AVAILABILITY_RATE_WINDOW_SECONDS=60

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your_cloud
CLOUDINARY_API_KEY=your_key
CLOUDINARY_API_SECRET=your_secret
